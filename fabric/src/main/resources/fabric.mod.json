{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contributors": [
        "gcewing (original author)"
    ],
    "contact": {
        "homepage": "https://github.com/AlmuraDev/SGCraft",
        "sources": "https://github.com/AlmuraDev/SGCraft",
        "issues": "https://github.com/AlmuraDev/SGCraft/issues"
    },
    "license": "${license}",
    "environment": "*",
    "accessWidener": "sgcraft.accesswidener",
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "entrypoints": {
        "main": [
            "com.almuradev.sgcraft.fabric.SGCraftFabric"
        ],
        "client": [
            "com.almuradev.sgcraft.fabric.SGCraftClientFabric"
        ],
        "modmenu": [
            "com.almuradev.sgcraft.fabric.SGCraftModMenu"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
